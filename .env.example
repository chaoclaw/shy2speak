# Copy this file to .env before starting. Do not commit the real .env file.
SHY2SPEAK_PORT=8080
POSTGRES_DB=shy2speak
POSTGRES_USER=shy2speak
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AUTH_SECRET=replace-with-at-least-32-random-characters
YOUTUBE_CAPTIONS_ENABLED=true
YOUTUBE_CAPTION_CACHE_HOURS=168

# Optional: the URL users open in their browser, for example http://192.168.1.20:8080
PUBLIC_ORIGIN=
TRUST_PROXY=false
ALLOWED_ORIGINS=

# Optional email verification and password-recovery delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS provider bridge. The server POSTs {to,message,purpose} as JSON.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
